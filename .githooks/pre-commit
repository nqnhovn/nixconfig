#!/usr/bin/env bash
# =====================================================================
# .GITHOOKS/PRE-COMMIT — AUTO FORMAT + VALIDATE CHO NIXOS CONFIG
# =====================================================================
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
echo -e "${YELLOW}🔍 Pre-commit: checking...${NC}"

# ── 1. Check for secrets leakage ─────────────────────────────────
# Block TẤT CẢ secrets files trừ .example (skip staged deletions)
SECRETS_BLOCKED=false
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  # Bỏ qua nếu file đã bị xóa (staged delete)
  if ! git diff --cached --diff-filter=D --name-only | grep -qFx "$f"; then
    echo "skip delete $f" >/dev/null
  else
    continue
  fi
  # Cho phép .example.nix và .example
  if [[ "$f" == *.example.nix ]] || [[ "$f" == *.example ]]; then
    continue
  fi
  echo -e "  ${RED}❌ BLOCKED: $f contains secrets!${NC}"
  echo -e "  ${YELLOW}   Chỉ file .example được phép commit.${NC}"
  SECRETS_BLOCKED=true
done < <(git diff --cached --name-only | grep -E '^secrets/' || true)
if $SECRETS_BLOCKED; then exit 1; fi

# Block key files & .pem anywhere in repo (trừ trong .example, skip deletions)
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  # Bỏ qua nếu file đã bị xóa (staged delete)
  if git diff --cached --diff-filter=D --name-only | grep -qFx "$f"; then
    continue
  fi
  # Bỏ qua nếu là file .example
  if [[ "$f" == *.example.nix ]] || [[ "$f" == *.example ]]; then
    continue
  fi
  echo -e "  ${RED}❌ BLOCKED: $f looks like a secret file!${NC}"
  SECRETS_BLOCKED=true
done < <(git diff --cached --name-only | grep -E '(keys\.nix$|\.key$|\.pem$|credentials|secret)' || true)
if $SECRETS_BLOCKED; then exit 1; fi

# ── 2. Check for leftover merge conflicts ────────────────────────
# Only match TRUE conflict markers (^<<<<<<< , ^=======$, ^>>>>>>> )
if git diff --cached --name-only | xargs grep -El '^(<<<<<<< |=======$|>>>>>>> )' 2>/dev/null; then
  echo -e "  ${RED}❌ BLOCKED: Merge conflict markers found!${NC}"
  exit 1
fi

# ── 3. Format Nix files ──────────────────────────────────────────
if command -v nixpkgs-fmt &>/dev/null; then
  for f in $(git diff --cached --name-only --diff-filter=ACM | grep '\.nix$' || true); do
    [ ! -f "$f" ] && continue
    nixpkgs-fmt --check "$f" 2>/dev/null || echo -e "  ${YELLOW}⚠️  $f needs formatting${NC}"
  done
fi

# ── 4. ShellCheck for scripts ──────────────────────────────────
if command -v shellcheck &>/dev/null; then
  for f in $(git diff --cached --name-only --diff-filter=ACM | grep '\.sh$' || true); do
    [ ! -f "$f" ] && continue
    shellcheck -x "$f" 2>/dev/null || echo -e "  ${YELLOW}⚠️  $f has shell issues${NC}"
  done
fi

echo -e "${GREEN}✅ Pre-commit passed!${NC}"
